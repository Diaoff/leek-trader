# syntax=docker/dockerfile:1

FROM node:20-alpine AS frontend-builder
WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
ENV VITE_API_BASE_URL=/api/v1
RUN npm run build

FROM python:3.12-slim AS runtime

ARG APT_MIRROR=""
ARG APT_SECURITY_MIRROR=""
ARG PIP_INDEX_URL=""
ARG PIP_TIMEOUT="120"
ARG PIP_RETRIES="10"
ARG INSTALL_RL_DEPS="0"

ENV PYTHONUNBUFFERED=1 \
    APP_ENV=production \
    API_PREFIX=/api/v1 \
    REDIS_URL=redis://127.0.0.1:6379/0 \
    POSTGRES_DB=leek_trader_prod \
    POSTGRES_USER=postgres \
    PGDATA=/var/lib/postgresql/data

RUN if [ -n "$APT_MIRROR" ]; then \
        sed -i "s#http://deb.debian.org/debian#${APT_MIRROR}#g" /etc/apt/sources.list.d/debian.sources; \
    fi \
    && if [ -n "$APT_SECURITY_MIRROR" ]; then \
        sed -i "s#http://deb.debian.org/debian-security#${APT_SECURITY_MIRROR}#g" /etc/apt/sources.list.d/debian.sources; \
    fi \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        nginx \
        postgresql \
        postgresql-contrib \
        redis-server \
        gosu \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/nginx/sites-enabled/default \
    && mkdir -p /app/backend /app/frontend/dist /run/nginx "$PGDATA" \
    && chown -R postgres:postgres /var/lib/postgresql /var/run/postgresql

WORKDIR /app/backend
COPY backend/requirements.txt /tmp/backend-requirements.txt
RUN if [ -n "$PIP_INDEX_URL" ]; then \
        pip install --no-cache-dir --timeout "$PIP_TIMEOUT" --retries "$PIP_RETRIES" -i "$PIP_INDEX_URL" -r /tmp/backend-requirements.txt; \
    else \
        pip install --no-cache-dir --timeout "$PIP_TIMEOUT" --retries "$PIP_RETRIES" -r /tmp/backend-requirements.txt; \
    fi
COPY backend/requirements-rl.txt /tmp/backend-requirements-rl.txt
RUN if [ "$INSTALL_RL_DEPS" = "1" ]; then \
        if [ -n "$PIP_INDEX_URL" ]; then \
            pip install --no-cache-dir --timeout "$PIP_TIMEOUT" --retries "$PIP_RETRIES" -i "$PIP_INDEX_URL" -r /tmp/backend-requirements-rl.txt; \
        else \
            pip install --no-cache-dir --timeout "$PIP_TIMEOUT" --retries "$PIP_RETRIES" -r /tmp/backend-requirements-rl.txt; \
        fi; \
    fi
COPY backend/ /app/backend/
COPY --from=frontend-builder /app/frontend/dist/ /app/frontend/dist/
COPY docker/all-in-one/nginx.conf /etc/nginx/nginx.conf
COPY docker/all-in-one/entrypoint.sh /usr/local/bin/leek-trader-all-in-one
RUN chmod +x /usr/local/bin/leek-trader-all-in-one

EXPOSE 80 5432
VOLUME ["/var/lib/postgresql/data"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
    CMD curl -fsS http://127.0.0.1/health >/dev/null || exit 1

ENTRYPOINT ["/usr/local/bin/leek-trader-all-in-one"]
