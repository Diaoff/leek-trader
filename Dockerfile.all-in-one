# syntax=docker/dockerfile:1

FROM node:20-alpine AS frontend-builder
WORKDIR /app/frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
ENV VITE_API_BASE_URL=/api/v1
RUN npm run build

FROM python:3.12-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    APP_ENV=production \
    API_PREFIX=/api/v1 \
    DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/leek_trader \
    REDIS_URL=redis://127.0.0.1:6379/0 \
    POSTGRES_DB=leek_trader \
    POSTGRES_USER=postgres \
    POSTGRES_PASSWORD=postgres \
    PGDATA=/var/lib/postgresql/data

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        nginx \
        postgresql \
        postgresql-contrib \
        redis-server \
        gosu \
    && rm -rf /var/lib/apt/lists/* \
    && rm -f /etc/nginx/sites-enabled/default \
    && mkdir -p /app/backend /app/frontend/dist /run/nginx /var/log/leek-trader "$PGDATA" \
    && chown -R postgres:postgres /var/lib/postgresql /var/run/postgresql

WORKDIR /app/backend
COPY backend/requirements.txt /tmp/backend-requirements.txt
RUN pip install --no-cache-dir -r /tmp/backend-requirements.txt
COPY backend/ /app/backend/
COPY --from=frontend-builder /app/frontend/dist/ /app/frontend/dist/
COPY docker/all-in-one/nginx.conf /etc/nginx/nginx.conf
COPY docker/all-in-one/entrypoint.sh /usr/local/bin/leek-trader-all-in-one
RUN chmod +x /usr/local/bin/leek-trader-all-in-one

EXPOSE 80
VOLUME ["/var/lib/postgresql/data"]

HEALTHCHECK --interval=30s --timeout=5s --start-period=45s --retries=3 \
    CMD curl -fsS http://127.0.0.1/health >/dev/null || exit 1

ENTRYPOINT ["/usr/local/bin/leek-trader-all-in-one"]
